{
  "manifest_version": 3,
  "name": "iOS Icon Downloader",
  "version": "1.2",
  "description": "ダブル右クリックで画像をiOSアプリアイコン風（角丸）にしてダウンロード",
  "permissions": [
    "downloads",
    "activeTab",
    "storage",
    "contextMenus"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "ダウンロード設定"
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
